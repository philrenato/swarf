{
    "mode": "CAM",
    "internal": 0,
    "bedHeight": 2.5,
    "bedWidth": 2400,
    "bedDepth": 1200,
    "maxHeight": 150,
    "originCenter": false,
    "spindleMax": 18000,
    "spindleMin": 9000,
    "feedMax": 15240,
    "feedMaxZ": 2540,
    "gcodePre": [
        "'UNITS:MM",
        "'",
        "CN, 90               'Set program to absolute coordinate mode",
        "IF %(25)=0 THEN GOTO UNIT_ERROR   'stop if the machine is set to inches",
        "'"
    ],
    "gcodePost": [
        "'Turning router OFF",
        "C7",
        "END",
        "'",
        "UNIT_ERROR:",
        "CN, 91               'Run file explaining unit error",
        "END"
    ],
    "gcodeDwell": [
        "PAUSE {time}"
    ],
    "gcodeSpindle": [
        "TR,{speed}",
        "C6",
        "PAUSE 2"
    ],
    "gcodeChange": [
        "C7                   'Spindle off for tool change",
        "&Tool ={tool}        'Load {tool_name}",
        "C9                   'Change tool"
    ],
    "gcodeFExt": ".sbp",
    "gcodeSpace": true,
    "gcodeStrip": true,
    "new": false,
    "deviceName": "ShopBot.Basic",
    "imageURL": "",
    "useLaser": false,
    "profiles": []
}
